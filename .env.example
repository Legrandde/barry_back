# Copier ce fichier en .env puis adapter les valeurs.

# "production" bloque le démarrage si SECRET_KEY ou ADMIN_PASSWORD gardent leur valeur par défaut
ENVIRONMENT=development

# SQLite par défaut ; PostgreSQL possible : postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./cms.db

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Compte admin créé au tout premier démarrage uniquement
# (ensuite, changer le mot de passe via PUT /api/auth/password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Origines du site et de l'interface d'admin, séparées par des virgules
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Fichiers téléversés
MEDIA_DIR=./media
MAX_UPLOAD_SIZE_MB=20
# Vidéos : taille max à l'envoi, et compression automatique au-delà du seuil (en Mo)
MAX_VIDEO_UPLOAD_SIZE_MB=300
VIDEO_COMPRESSION_THRESHOLD_MB=15
# Plus petit côté de la vidéo compressée (720 = 720p) et qualité H.264 (18 = excellente, 32 = légère)
VIDEO_MAX_DIMENSION=720
VIDEO_CRF=28
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# URL publique de l'API, utilisée pour construire les liens des médias (ex: https://api.mondomaine.com)
PUBLIC_BASE_URL=

# Statistiques de visite : durée de conservation en jours
ANALYTICS_RETENTION_DAYS=395
# Base locale DB-IP City Lite (téléchargée via `uv run python -m db.download_geoip`)
GEOIP_DB_PATH=./data/dbip-city-lite.mmdb
